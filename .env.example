PORT=3333
FRONTEND_URL=http://localhost:9000
JWT_SECRET=your-secret-key

# ── Local Docker Postgres (used when DATABASE_URL is not set) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=georanao
DB_PASSWORD=georanao_dev_password
DB_NAME=geo_ranao

# ── Production / Supabase (takes priority over the DB_* vars above when set) ──
# Get this from Supabase: Project Settings -> Database -> Connection string (URI).
# DATABASE_URL=postgresql://postgres.xxxxx:[password]@aws-0-xxxxx.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://localhost:[password]@aws-0-xxxxx.pooler.supabase.com:6543/postgres
# DB_SSL=true

# Bootstrap admin created by `yarn seed` (change these before running in anything but local dev)
ADMIN_EMAIL=admin@georanao.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator

# Fish observation photos — stored in Supabase Storage (private bucket, auto-created),
# auto-deleted after PHOTO_RETENTION_DAYS. Required even in local dev — there is no
# local-disk fallback. Get these from Supabase: Project Settings -> API Keys
# (SUPABASE_SECRET_KEY is the "Secret key", sb_secret_... — never the "Publishable key").
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=fish-photos
PHOTO_RETENTION_DAYS=14
